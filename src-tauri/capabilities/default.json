{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主視窗：基本功能、用系統瀏覽器開連結（只限 http、https、mailto）",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}
