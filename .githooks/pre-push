#!/usr/bin/env bash
# 推送前的本地檢查（本 repo 不用 GitHub Actions 跑 PR 檢查）
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 只刪除遠端分支時不用檢查（stdin 每行：本地 ref、本地 sha、遠端 ref、遠端 sha；刪除時本地 sha 全是 0）
needs_check=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || needs_check=1
done
[[ "$needs_check" == 1 ]] || exit 0

npm run check
