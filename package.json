{
  "name": "api-chat",
  "version": "0.1.0",
  "private": true,
  "description": "用自己的 Anthropic API 金鑰對話的桌面 App",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --disable-warning=ExperimentalWarning test/unit/*.test.ts",
    "e2e": "scripts/e2e.sh",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
